#ifndef SPATIOTEMPORAL_REUSE_COMMON_SLANGH
#define SPATIOTEMPORAL_REUSE_COMMON_SLANGH

import PathReservoir;
import Scene.Scene;
import Scene.Raytracing;
import Scene.RaytracingInline;
import Scene.Shading;
import Scene.HitInfo;
import Utils.Geometry.GeometryHelpers;
import Utils.Sampling.SampleGenerator;
import Utils.Math.MathHelpers;
import LightUtils;

static const float kEpsT = 1e-4f;

float TargetWeight(float3 pathF)
{
    return max(0.0, dot(pathF, float3(0.2126, 0.7152, 0.0722)));
}

void ReservoirInit(out PathReservoir r)
{
    r = {};
    r.UCW = 0.0;
    r.misWeight = 1.0;
    r.confidenceWeight = 1.0;
    r.flags.clear();
}

void ReservoirMerge(inout PathReservoir r, PathReservoir cand, float w, inout SampleGenerator sg)
{
    if (w <= 0.0) return;

    float Wnew = r.UCW + w;
    float xi = sampleNext1D(sg);
    if (xi < (w / max(1e-20, Wnew)))
        r = cand;

    r.UCW = Wnew;
}

bool Visible(float3 a, float3 aNg, float3 b, float maxDist)
{
    SceneRayQuery<0> rq;
    float3 dir = normalize(b - a);
    Ray ray = Ray(computeRayOrigin(a, aNg), dir, kEpsT, maxDist - kEpsT);
    return rq.traceVisibilityRay(ray);
}

bool ReconstructEmissivePoint(SceneVertex y0, out float3 yPos, out float3 yNs, out float3 yNg, out float3 Le, out float pA_y)
{
    uint triIdx = y0.primitiveID;

    EmissiveTriangle tri = gScene.lightCollection.getTriangle(triIdx);
    MeshLightData meshData = gScene.lightCollection.meshData[tri.lightIdx];

    float3 bary;
    bary.x = 1.0 - y0.bary.x - y0.bary.y;
    bary.yz = y0.bary;

    yPos = tri.getPosition(bary);
    yNg  = tri.normal;
    yNs  = tri.normal;

    float2 uv = tri.getTexCoord(bary);
    Le = gScene.materials.evalEmissive(tri.materialID, uv);

    pA_y = 1.0 / max(1e-20, tri.area);

    return true;
}

bool EvaluateShiftedNEE(
    PathReservoir src,
    PathVertex newX,
    ShadingData sdX,
    IMaterialInstance miX,
    inout SampleGenerator sg,
    out PathReservoir dst )
{
    dst = {};
    dst = src;

    float3 yPos, yNs, yNg, Le;
    float pA_y;
    if (!ReconstructEmissivePoint(src.y0, yPos, yNs, yNg, Le, pA_y))
        return false;

    float3 dir = normalize(yPos - newX.pos);
    float dist = length(yPos - newX.pos);
    if (dist <= 1e-6) return false;

    if (!Visible(newX.pos, newX.faceNormal, yPos, dist))
        return false;

    float cosX = max(0.0, dot(newX.normal, dir));
    float cosY = max(0.0, dot(yNs, -dir));
    if (cosX <= 0.0 || cosY <= 0.0) return false;

    float3 f = miX.eval(sdX, dir, sg);
    float pdfW = miX.evalPdf(sdX, dir);
    if (pdfW <= 0.0) return false;

    float pW_light = pA_y * (dist * dist) / max(1e-20, cosY);

    float3 contrib = f * Le * (cosX / max(1e-20, pW_light));

    dst.pathF = contrib;
    dst.xr = newX;
    return true;
}

bool EvaluateShiftedLVC(
    PathReservoir src,
    PathVertex newX,
    ShadingData sdX,
    IMaterialInstance miX,
    StructuredBuffer<LightSubpathVertex> lightCache,
    inout SampleGenerator sg,
    out PathReservoir dst)
{
    dst = {};
    dst = src;

    uint lvcIdx = src.lightPathId;
    LightSubpathVertex y = lightCache[lvcIdx];

    float3 yPos = y.y_s1.pos;

    float3 dir = normalize(yPos - newX.pos);
    float dist = length(yPos - newX.pos);
    if (dist <= 1e-6) return false;

    if (!Visible(newX.pos, newX.faceNormal, yPos, dist))
        return false;

    float cosX = max(0.0, dot(newX.normal, dir));
    float cosY = max(0.0, dot(y.y_s1.normal, -dir));
    if (cosX <= 0.0 || cosY <= 0.0) return false;

    float3 f = miX.eval(sdX, dir, sg);
    float pdfW = miX.evalPdf(sdX, dir);
    if (pdfW <= 0.0) return false;

    float G = (cosX * cosY) / max(1e-20, dist * dist);

    dst = src;
    dst.xr = newX;
    dst.pathF = src.pathF;

    return true;
}

uint Hash32(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352d;
    x ^= x >> 15;
    x *= 0x846ca68b;
    x ^= x >> 16;
    return x;
}

uint PickReplayPixel(PathReservoir r, uint2 dim, uint frameCount)
{
    uint n = dim.x * dim.y;
    uint h = Hash32(r.lightPathSeed ^ (r.lightPathId * 1664525u) ^ (frameCount * 1013904223u));
    return (n == 0) ? 0 : (h % n);
}

#endif
