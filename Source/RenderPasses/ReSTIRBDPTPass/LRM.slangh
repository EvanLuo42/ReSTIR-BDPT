#ifndef LRM_SLANG
#define LRM_SLANG

import PathReservoir;

#define LRM_NUM_BUCKETS 100000u
#define LRM_BUCKET_ENTRIES 32u
#define LRM_CELL_ENTRY_COUNT (LRM_NUM_BUCKETS * LRM_BUCKET_ENTRIES)

struct LRMRecord
{
    PathReservoir reservoir;
    uint pixelIndex;
};

struct LRMTriplet
{
    uint recordId;
    uint cellEntryId;
    uint localIndex;
    uint pad0;
};

cbuffer LRMLimitsCB
{
    uint gLRMMaxRecords;
    uint gLRMMaxTriplets;
    uint gLRMMaxCellStorage;
    uint gLRMMaxPerCell;
    float gCellSize;
}

RWStructuredBuffer<LRMRecord> gLRMRecords;
RWStructuredBuffer<LRMTriplet> gLRMTriplets;

RWStructuredBuffer<uint> gLRMRecordCount;
RWStructuredBuffer<uint> gLRMTripletCount;

RWStructuredBuffer<uint> gLRMCellChecksum;
RWStructuredBuffer<uint> gLRMCellCount;
RWStructuredBuffer<uint> gLRMCellOffset;

RWStructuredBuffer<uint> gLRMCellStorage;

uint lrm_pcg(uint x)
{
    x = x * 747796405u + 2891336453u;
    uint word = ((x >> ((x >> 28u) + 4u)) ^ x) * 277803737u;
    return (word >> 22u) ^ word;
}

uint lrm_mix(uint x)
{
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}

uint LRM_FindOrInsertCell(float3 posW, float cellSize)
{
    int3 p = (int3)floor(posW / cellSize);

    uint key = lrm_pcg(asuint(cellSize));
    key = lrm_pcg(key ^ (uint)p.x);
    key = lrm_pcg(key ^ (uint)p.y);
    key = lrm_pcg(key ^ (uint)p.z);

    uint bucket = lrm_pcg(key) % LRM_NUM_BUCKETS;
    uint checksum = max(lrm_mix(key), 1u);

    [unroll]
    for (uint i = 0; i < LRM_BUCKET_ENTRIES; ++i)
    {
        uint idx = bucket * LRM_BUCKET_ENTRIES + i;

        uint prev;
        InterlockedCompareExchange(gLRMCellChecksum[idx], 0u, checksum, prev);

        if (prev == 0u || prev == checksum)
            return idx;
    }

    return 0xFFFFFFFFu;
}

void LRM_InsertReservoir(uint pixelIndex, PathReservoir r)
{
    uint recordId;
    InterlockedAdd(gLRMRecordCount[0], 1, recordId);

    if (recordId >= gLRMMaxRecords)
        return;

    gLRMRecords[recordId].reservoir = r;
    gLRMRecords[recordId].pixelIndex = pixelIndex;

    uint cellEntryId = LRM_FindOrInsertCell(r.xr.pos, gCellSize);
    if (cellEntryId == 0xFFFFFFFFu)
        return;

    uint localIndex;
    InterlockedAdd(gLRMCellCount[cellEntryId], 1, localIndex);

    if (localIndex >= gLRMMaxPerCell)
    {
        InterlockedAdd(gLRMCellCount[cellEntryId], -1);
        return;
    }

    uint tripletId;
    InterlockedAdd(gLRMTripletCount[0], 1, tripletId);

    if (tripletId >= gLRMMaxTriplets)
        return;

    gLRMTriplets[tripletId] = LRMTriplet(recordId, cellEntryId, localIndex, 0);
}

uint LRM_ComputeCellIndex(float3 posW, float cellSize)
{
    int3 p = (int3)floor(posW / cellSize);

    uint key = lrm_pcg(asuint(cellSize));
    key = lrm_pcg(key ^ (uint)p.x);
    key = lrm_pcg(key ^ (uint)p.y);
    key = lrm_pcg(key ^ (uint)p.z);

    uint bucket = lrm_pcg(key) % LRM_NUM_BUCKETS;
    uint checksum = max(lrm_mix(key), 1u);

    [unroll]
    for (uint i = 0; i < LRM_BUCKET_ENTRIES; ++i)
    {
        uint idx = bucket * LRM_BUCKET_ENTRIES + i;

        if (gLRMCellChecksum[idx] == checksum)
            return idx;
    }

    return 0xFFFFFFFFu;
}

#endif
